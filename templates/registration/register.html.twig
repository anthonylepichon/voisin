{#
 Description générale : Page publique d'inscription à l'application Voisin.
 Rôle : Afficher le formulaire Symfony de création d'un compte.
 Tâches : Présenter les champs obligatoires et leurs erreurs de validation avec les styles communs.
 Liens avec les autres fichiers : Utilise RegistrationFormType, RegistrationController et les styles auth et forms.
#}

{% extends 'base.html.twig' %}

{% block title %}Inscription — Voisin{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
    <section class="auth-card auth-card--registration" aria-labelledby="titre-inscription">
        <div class="auth-card__heading">
            <h1 class="auth-card__title" id="titre-inscription">Créer un compte</h1>
            <p class="auth-card__subtitle">Rejoins ton voisinage en quelques instants.</p>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'auth-card__form'}}) }}
            {{ form_errors(registrationForm) }}
            <div class="form-field">
                {{ form_label(registrationForm.pseudonyme, null, {'label_attr': {'class': 'form-field__label'}}) }}
                {{ form_widget(registrationForm.pseudonyme, {'attr': {'class': 'form-field__control', 'placeholder': 'Ton pseudonyme'}}) }}
                {{ form_errors(registrationForm.pseudonyme) }}
            </div>
            <div class="form-field">
                {{ form_label(registrationForm.adresseEmail, null, {'label_attr': {'class': 'form-field__label'}}) }}
                {{ form_widget(registrationForm.adresseEmail, {'attr': {'class': 'form-field__control', 'placeholder': 'ton.email@exemple.fr'}}) }}
                {{ form_errors(registrationForm.adresseEmail) }}
            </div>
            <div class="file-upload file-upload--avatar" data-photo-profil>
                {{ form_label(registrationForm.photoProfil, null, {'label_attr': {'class': 'file-upload__label'}}) }}
                <label class="file-upload__zone" for="{{ registrationForm.photoProfil.vars.id }}">Choisir une photo
                    {{ form_widget(registrationForm.photoProfil, {'attr': {'class': 'file-upload__input', 'accept': 'image/jpeg,image/png,image/webp', 'data-photo-profil-input': ''}}) }}
                </label>
                <div class="file-upload__preview" data-photo-profil-preview hidden>
                    <img class="file-upload__preview-image" src="" alt="Aperçu de la photo de profil" data-photo-profil-image>
                    <span class="file-upload__filename" data-photo-profil-name></span>
                </div>
                {{ form_errors(registrationForm.photoProfil) }}
            </div>
            <div class="form-field">
                {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-field__label'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-field__control', 'placeholder': '8 caractères minimum'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
            <button class="button button--primary auth-card__submit" type="submit">Créer mon compte</button>
        {{ form_end(registrationForm) }}

        <p class="auth-card__footer">Déjà inscrit ? <a class="auth-card__footer-link" href="{{ path('app_login') }}">Connecte-toi</a>.</p>
    </section>
{% endblock %}
