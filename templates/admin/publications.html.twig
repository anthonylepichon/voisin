{#
Origine du code : Code créé par le développeur.
Description générale : Liste administrative de modération des publications.
Rôle : Donner accès aux commentaires et à la suppression sécurisée d'une publication.
Tâches : Afficher toutes les publications, leur utilisateur, leur date, leur visibilité et les actions autorisées.
Liens avec les autres fichiers : Étend base.html.twig et utilise AdminController, PublicationController et CommentController.
#}

{% extends 'base.html.twig' %}

{% block title %}Modération des publications — Voisin{% endblock %}

{% block body %}
    <div class="app-shell">
        <aside class="app-shell__sidebar">
            {% include 'partials/_admin_sidebar.html.twig' %}
        </aside>

        <section class="app-shell__main admin-page" aria-labelledby="titre-moderation">
            <header class="admin-page__header">
                <div>
                    <h1 class="admin-page__title" id="titre-moderation">Modération des publications</h1>
                    <p class="admin-page__count">{{ publications|length }} publication{% if publications|length != 1 %}s{% endif %}</p>
                </div>
            </header>

            {% if publications is empty %}
                <div class="admin-page__empty">
                    <p class="admin-page__empty-title">Aucune publication à modérer.</p>
                    <p class="admin-page__empty-description">Les publications créées apparaîtront ici.</p>
                </div>
            {% else %}
                <div class="moderation-list">
                    {% for publication in publications %}
                        <article class="moderation-item">
                            <span class="moderation-item__thumbnail">
                                {% if publication.imageAffichee %}
                                    <img class="moderation-item__thumbnail-image" src="{{ path('app_upload_fichier', {type: 'publication', nom: publication.imageAffichee}) }}" alt="">
                                {% else %}
                                    <img class="moderation-item__thumbnail-image" src="{{ path('app_upload_fichier', {type: 'profil', nom: publication.utilisateur.uploadFichier.nom}) }}" alt="">
                                {% endif %}
                            </span>
                            <span class="moderation-item__details">
                                <strong class="moderation-item__author">{{ publication.utilisateur.pseudonyme }}</strong>
                                <span class="moderation-item__excerpt">
                                    {% if publication.aUnContenuTexte() %}
                                        {{ publication.contenu|slice(0, 90) }}{% if publication.contenu|length > 90 %}…{% endif %}
                                    {% else %}
                                        Publication avec une image
                                    {% endif %}
                                </span>
                                <time class="moderation-item__date" datetime="{{ publication.dateCreation|date('c') }}">{{ publication.dateCreation|date('d/m/Y à H:i') }} · {{ publication.visibilite }}</time>
                            </span>
                            <span class="moderation-item__actions">
                                <a class="moderation-item__comments" href="{{ path('app_comment_index', {id: publication.id, administration: 1}) }}">
                                    Modérer les commentaires ({{ publication.commentaires|length }})
                                </a>
                                <form action="{{ path('app_publication_delete', {id: publication.id}) }}" method="post" onsubmit="return confirm('Supprimer cette publication ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-publication-' ~ publication.id) }}">
                                    <input type="hidden" name="_retour" value="administration">
                                    <button class="moderation-item__delete" type="submit">Supprimer</button>
                                </form>
                            </span>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
