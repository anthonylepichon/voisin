{#
Origine du code : Code créé par le développeur.
Description générale : Carte réutilisable d'une publication.
Rôle : Afficher l'utilisateur, la visibilité, le contenu, l'image et les interactions sociales.
Tâches : Afficher les compteurs agrégés, proposer le like, l'accès aux commentaires et les actions réservées au propriétaire.
Liens avec les autres fichiers : Inclus dans l'accueil, le fil et les profils avec les statistiques préparées par PublicationRepository.
#}

{% set imagePublication = publication.imageAffichee %}
{% set classeVarianteCarte = 'publication-card--feed' %}
{% if varianteCarte is defined %}
	{% set classeVarianteCarte = varianteCarte %}
{% endif %}
{% set actionsProprietaireVisibles = true %}
{% if afficherActionsProprietaire is defined and afficherActionsProprietaire == false %}
	{% set actionsProprietaireVisibles = false %}
{% endif %}

<article class="publication-card{% if classeVarianteCarte %} {{ classeVarianteCarte }}{% endif %}">
	<header class="publication-card__header">
		<a class="publication-card__author" href="{{ path('app_profile_show', {pseudonyme: publication.utilisateur.pseudonyme}) }}">
			<span class="avatar avatar--medium">
				<img class="avatar__image" src="{{ path('app_upload_fichier', {type: 'profil', nom: publication.utilisateur.uploadFichier.nom}) }}" alt="Photo de profil de {{ publication.utilisateur.pseudonyme }}">
			</span>
			<span class="publication-card__author-details">
				<span class="publication-card__author-name">{{ publication.utilisateur.pseudonyme }}</span>
				<time class="publication-card__date" datetime="{{ publication.dateCreation|date('c') }}">{{ publication.dateCreation|date('d/m/Y à H:i') }}</time>
			</span>
		</a>

		<span class="badge">
			{% if publication.visibilite == 'publique' %}
				<span class="badge__icon"><img src="{{ asset('images/icons/icon_GlobeSimple.png') }}" alt=""></span>
				Publique
			{% else %}
				<span class="badge__icon"><img src="{{ asset('images/icons/icon_users.png') }}" alt=""></span>
				Amis
			{% endif %}
		</span>
	</header>

	{% if publication.aUnContenuTexte() %}
		<p class="publication-card__text">{{ publication.contenu }}</p>
	{% endif %}

	{% if imagePublication %}
		<div class="publication-card__media">
			<img class="publication-card__media-image" src="{{ path('app_upload_fichier', {type: 'publication', nom: imagePublication}) }}" alt="Image publiée par {{ publication.utilisateur.pseudonyme }}">
		</div>
	{% endif %}

	{% if app.user %}
		<form action="{{ path('app_publication_like', {id: publication.id}) }}" method="post">
			<input type="hidden" name="_token" value="{{ csrf_token('aimer-publication-' ~ publication.id) }}">
			<input type="hidden" name="retour" value="{{ app.request.requestUri }}">
			<button class="publication-card__like{% if statistiques.utilisateurConnecteAime %} publication-card__like--active{% endif %}" type="submit" aria-pressed="{% if statistiques.utilisateurConnecteAime %}true{% else %}false{% endif %}" aria-label="{% if statistiques.utilisateurConnecteAime %}Retirer mon like{% else %}Aimer cette publication{% endif %}, {{ statistiques.nombreMentionsJaime }} mention{% if statistiques.nombreMentionsJaime > 1 %}s{% endif %} J’aime">
				<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_heart.png') }}" alt=""></span>
				<span class="publication-card__action-count">{{ statistiques.nombreMentionsJaime }}</span>
			</button>
		</form>
		<a class="publication-card__comments" href="{{ path('app_comment_index', {id: publication.id}) }}" aria-label="Consulter {{ statistiques.nombreCommentaires }} commentaire{% if statistiques.nombreCommentaires > 1 %}s{% endif %}">
			<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_chatCircle.png') }}" alt=""></span>
			<span class="publication-card__action-count">{{ statistiques.nombreCommentaires }}</span>
		</a>
	{% else %}
		<span class="publication-card__like" aria-label="{{ statistiques.nombreMentionsJaime }} mentions J’aime">
			<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_heart.png') }}" alt=""></span>
			<span class="publication-card__action-count">{{ statistiques.nombreMentionsJaime }}</span>
		</span>
		<span class="publication-card__comments" aria-label="{{ statistiques.nombreCommentaires }} commentaires">
			<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_chatCircle.png') }}" alt=""></span>
			<span class="publication-card__action-count">{{ statistiques.nombreCommentaires }}</span>
		</span>
	{% endif %}

	{% if actionsProprietaireVisibles and app.user and app.user.id == publication.utilisateur.id %}
		<div class="publication-card__owner-actions">
			<a class="publication-card__owner-action" href="{{ path('app_publication_edit', {id: publication.id}) }}">Modifier</a>
			<form action="{{ path('app_publication_delete', {id: publication.id}) }}" method="post" onsubmit="return confirm('Supprimer cette publication ?');">
				<input type="hidden" name="_token" value="{{ csrf_token('supprimer-publication-' ~ publication.id) }}">
				<button class="publication-card__owner-action publication-card__owner-action--delete" type="submit">Supprimer</button>
			</form>
		</div>
	{% endif %}
</article>
