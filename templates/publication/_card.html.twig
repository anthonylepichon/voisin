{#
Description générale : Carte réutilisable d'une publication.
Rôle : Afficher l'utilisateur, la visibilité, le contenu, l'image et les interactions sociales.
Tâches : Proposer le like, l'accès aux commentaires et les actions réservées au propriétaire.
Liens avec les autres fichiers : Inclus dans le fil et les profils, puis relié à PublicationController et CommentController.
#}

{% set utilisateurConnecteAime = app.user and app.user in publication.utilisateursAimant %}

<article class="publication-card publication-card--feed">
	<header class="publication-card__header">
		<a class="publication-card__author" href="{{ path('app_profile_show', {pseudonyme: publication.utilisateur.pseudonyme}) }}">
			<span class="avatar avatar--medium">
				<img class="avatar__image" src="{{ path('app_upload_fichier', {type: 'profil', nom: publication.utilisateur.nomPhotoProfil}) }}" alt="Photo de profil de {{ publication.utilisateur.pseudonyme }}">
			</span>
			<span class="publication-card__author-details">
				<span class="publication-card__author-name">{{ publication.utilisateur.pseudonyme }}</span>
				<time class="publication-card__date" datetime="{{ publication.dateCreation|date('c') }}">{{ publication.dateCreation|date('d/m/Y à H:i') }}</time>
			</span>
		</a>

		<span class="badge">
			{% if publication.visibilite == 'publique' %}
				<span class="badge__icon"><img src="{{ asset('images/icons/icon_GlobeSimple.png') }}" alt=""></span>
				Publique
			{% else %}
				<span class="badge__icon"><img src="{{ asset('images/icons/icon_users.png') }}" alt=""></span>
				Amis uniquement
			{% endif %}
		</span>
	</header>

	{% if publication.contenu is not null and publication.contenu|trim != '' %}
		<p class="publication-card__text">{{ publication.contenu|nl2br }}</p>
	{% endif %}

	{% if publication.nomImage %}
		<div class="publication-card__media">
			<img class="publication-card__media-image" src="{{ path('app_upload_fichier', {type: 'publication', nom: publication.nomImage}) }}" alt="Image publiée par {{ publication.utilisateur.pseudonyme }}">
		</div>
	{% endif %}

	{% if app.user %}
		<form action="{{ path('app_publication_like', {id: publication.id}) }}" method="post">
			<input type="hidden" name="_token" value="{{ csrf_token('aimer-publication-' ~ publication.id) }}">
			<input type="hidden" name="retour" value="{{ app.request.requestUri }}">
			<button class="publication-card__like{% if utilisateurConnecteAime %} publication-card__like--active{% endif %}" type="submit" aria-pressed="{% if utilisateurConnecteAime %}true{% else %}false{% endif %}" aria-label="{% if utilisateurConnecteAime %}Retirer mon like{% else %}Aimer cette publication{% endif %}, {{ publication.utilisateursAimant|length }} mention{% if publication.utilisateursAimant|length > 1 %}s{% endif %} J’aime">
				<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_heart.png') }}" alt=""></span>
				<span class="publication-card__action-count">{{ publication.utilisateursAimant|length }}</span>
			</button>
		</form>
		<a class="publication-card__comments" href="{{ path('app_comment_index', {id: publication.id}) }}" aria-label="Consulter {{ publication.commentaires|length }} commentaire{% if publication.commentaires|length > 1 %}s{% endif %}">
			<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_chatCircle.png') }}" alt=""></span>
			<span class="publication-card__action-count">{{ publication.commentaires|length }}</span>
		</a>
	{% else %}
		<span class="publication-card__like" aria-label="{{ publication.utilisateursAimant|length }} mentions J’aime">
			<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_heart.png') }}" alt=""></span>
			<span class="publication-card__action-count">{{ publication.utilisateursAimant|length }}</span>
		</span>
		<span class="publication-card__comments" aria-label="{{ publication.commentaires|length }} commentaires">
			<span class="publication-card__action-icon"><img src="{{ asset('images/icons/icon_chatCircle.png') }}" alt=""></span>
			<span class="publication-card__action-count">{{ publication.commentaires|length }}</span>
		</span>
	{% endif %}

	{% if app.user and app.user.id == publication.utilisateur.id %}
		<div class="publication-card__owner-actions">
			<a class="publication-card__owner-action" href="{{ path('app_publication_edit', {id: publication.id}) }}">Modifier</a>
			<form action="{{ path('app_publication_delete', {id: publication.id}) }}" method="post" onsubmit="return confirm('Supprimer cette publication ?');">
				<input type="hidden" name="_token" value="{{ csrf_token('supprimer-publication-' ~ publication.id) }}">
				<button class="publication-card__owner-action publication-card__owner-action--delete" type="submit">Supprimer</button>
			</form>
		</div>
	{% endif %}
</article>
