{#
 Description générale : Page de modification d'une publication existante.
 Rôle : Permettre à son propriétaire de modifier le contenu, l'image et la visibilité.
 Tâches : Afficher l'image actuelle, proposer son retrait et présenter l'action de suppression sécurisée.
 Liens avec les autres fichiers : Utilise PublicationController, PublicationFormType, le fragment publication/_form et les styles publication-editor.
#}

{% extends 'base.html.twig' %}

{% block title %}Modifier une publication — Voisin
{% endblock %}
{% block body_class %}publication-editor-page
{% endblock %}

{% block body %}
	<div class="app-shell">
		<aside class="app-shell__sidebar">
			{% include 'partials/_member_sidebar.html.twig' %}
		</aside>
		<section class="app-shell__main publication-editor" aria-labelledby="titre-modification-publication">
			<h1 class="publication-editor__title" id="titre-modification-publication">Modifier la publication</h1>
			{% include 'publication/_form.html.twig' with {
                publication: publication,
                afficherSuppressionImage: true,
                libelleValidation: 'Enregistrer'
            } %}

			<form action="{{ path('app_publication_delete', {id: publication.id}) }}" method="post">
				<input type="hidden" name="_token" value="{{ csrf_token('supprimer-publication-' ~ publication.id) }}">
				<button class="button button--danger-outline" type="submit">Supprimer la publication</button>
			</form>
		</section>
	</div>
{% endblock %}
