{#
Origine du code : Structure générée par Symfony puis modifiée par le développeur.
Description générale :
Gabarit HTML commun aux futures pages de l'application.
Rôle :
Fournir la structure de base et les blocs Twig réutilisables.
Tâches :
Charger le favicon et les ressources classiques servies par AssetMapper, puis accueillir le contenu des pages.
Liens avec les autres fichiers :
Charge le favicon, la feuille de styles et les scripts fonctionnels situés dans assets/js ; sera étendu par les autres modèles Twig.
#}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#f0e8e3">
        <title>{% block title %}Voisin — Le réseau de quartier{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon/favicon.svg') }}" type="image/svg+xml" sizes="any">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script src="{{ asset('js/profile-photo-preview.js') }}" defer></script>
            <script src="{{ asset('js/publication-image-preview.js') }}" defer></script>
            <script src="{{ asset('js/publication-composer.js') }}" defer></script>
            <script src="{{ asset('js/publication-masonry.js') }}" defer></script>
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block site_header %}
            {% include 'partials/_header.html.twig' %}
        {% endblock %}

        <main id="contenu-principal">
            {% include 'partials/_flash_messages.html.twig' %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
