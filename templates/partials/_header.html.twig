{#
Description générale : En-tête commun aux pages publiques et authentifiées de l'application Voisin.
Rôle : Afficher l'identité visuelle et les accès adaptés à l'état de connexion.
Tâches : Présenter le logo, les accès publics ou les actions du membre connecté.
Liens avec les autres fichiers : Inclus par templates/base.html.twig et stylisé par resources/scss/layout/_header.scss.
#}
{% set routeCourante = app.request.attributes.get('_route') %}
{% set routesEnteteComplet = ['app_home', 'app_feed', 'app_profile_current', 'app_profile_show', 'app_friendship_requests', 'app_friendship_friends'] %}

<header class="site-header{% if app.user %} site-header--authenticated{% if routeCourante not in routesEnteteComplet %} site-header--compact{% endif %}{% else %} site-header--public{% endif %}">
    <a class="site-header__brand" href="{% if app.user %}{{ path('app_feed') }}{% else %}{{ path('app_home') }}{% endif %}" aria-label="Accueil Voisin">
        <img class="site-header__logo" src="{{ asset('images/logo/00-logo.png') }}" alt="Voisin">
    </a>

    {% if app.user %}
        <nav class="site-header__actions site-header__actions--authenticated" aria-label="Accès au compte">
            {% if routeCourante in routesEnteteComplet %}
                <div class="site-header__search" aria-label="Recherche de membres">
                    <span class="site-header__search-placeholder">Rechercher</span>
                    <img class="site-header__search-icon" src="{{ asset('images/icons/icon_magnifyingGlass.png') }}" alt="">
                </div>
                <span class="site-header__notification"{% if nombreDemandesAmitieEnAttente is defined and nombreDemandesAmitieEnAttente > 0 %} aria-label="{{ nombreDemandesAmitieEnAttente }} demande{% if nombreDemandesAmitieEnAttente > 1 %}s{% endif %} d’amitié en attente"{% else %} aria-hidden="true"{% endif %}>
                    <img class="site-header__notification-image" src="{{ asset('images/icons/icon_notif.png') }}" alt="">
                    {% if nombreDemandesAmitieEnAttente is defined and nombreDemandesAmitieEnAttente > 0 %}
                        <span class="site-header__notification-badge" aria-hidden="true">{{ nombreDemandesAmitieEnAttente }}</span>
                    {% endif %}
                </span>
            {% endif %}
            <a class="site-header__member-link" href="{{ path('app_profile_current') }}" aria-label="Mon profil">
                <span class="site-header__avatar">
                    <img class="site-header__avatar-image" src="{{ path('app_profile_photo', {nom: app.user.nomPhotoProfil}) }}" alt="Photo de profil de {{ app.user.pseudonyme }}">
                </span>
            </a>
        </nav>
    {% else %}
        <nav class="site-header__actions" aria-label="Accès au compte">
            <a class="site-header__login" href="{{ path('app_login') }}">Me connecter</a>
            <a class="site-header__register" href="{{ path('app_register') }}">Créer un compte</a>
        </nav>
    {% endif %}
</header>
