{#
Origine du code : Code créé par le développeur.
Description générale : Navigation latérale partagée des pages authentifiées.
Rôle : Donner accès au fil, au profil, aux relations d'amitié, à l'administration autorisée et à la déconnexion.
Tâches : Marquer la page active, afficher le compteur des demandes, présenter les accès administratifs selon le rôle et protéger la déconnexion par CSRF.
Liens avec les autres fichiers : Inclus dans les pages membre et stylisé par layout/_sidebar.scss.
#}

{% set routeCourante = app.request.attributes.get('_route') %}

<nav class="side-nav{% if is_granted('ROLE_ADMIN') %} side-nav--admin-extended{% endif %}" aria-label="Navigation membre">
    <div class="side-nav__links">
        <a class="side-nav__link{% if routeCourante == 'app_feed' %} side-nav__link--active{% endif %}" href="{{ path('app_feed') }}"{% if routeCourante == 'app_feed' %} aria-current="page"{% endif %}>Mon fil d’actualité</a>
        <a class="side-nav__link{% if routeCourante starts with 'app_profile' %} side-nav__link--active{% endif %}" href="{{ path('app_profile_current') }}"{% if routeCourante starts with 'app_profile' %} aria-current="page"{% endif %}>Mon profil</a>
        <a class="side-nav__link{% if routeCourante == 'app_friendship_friends' %} side-nav__link--active{% endif %}" href="{{ path('app_friendship_friends') }}"{% if routeCourante == 'app_friendship_friends' %} aria-current="page"{% endif %}>Mes amis</a>
        <a class="side-nav__link{% if routeCourante == 'app_friendship_requests' %} side-nav__link--active{% endif %}" href="{{ path('app_friendship_requests') }}"{% if routeCourante == 'app_friendship_requests' %} aria-current="page"{% endif %}>
            Mes demandes
            {% if nombreDemandesAmitieEnAttente is defined and nombreDemandesAmitieEnAttente > 0 %}
                <span class="side-nav__badge" aria-label="{{ nombreDemandesAmitieEnAttente }} demande{% if nombreDemandesAmitieEnAttente > 1 %}s{% endif %} en attente">{{ nombreDemandesAmitieEnAttente }}</span>
            {% endif %}
        </a>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="side-nav__link{% if routeCourante == 'app_admin_index' %} side-nav__link--active{% endif %}" href="{{ path('app_admin_index') }}"{% if routeCourante == 'app_admin_index' %} aria-current="page"{% endif %}>Administration</a>
            <a class="side-nav__link{% if routeCourante == 'app_admin_publications' %} side-nav__link--active{% endif %}" href="{{ path('app_admin_publications') }}"{% if routeCourante == 'app_admin_publications' %} aria-current="page"{% endif %}>Modération</a>
        {% endif %}
    </div>
    <hr class="side-nav__separator">
    <form action="{{ path('app_logout') }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
        <button class="side-nav__logout" type="submit">Me déconnecter</button>
    </form>
</nav>
